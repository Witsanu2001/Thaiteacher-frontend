rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Profile fields, especially role and plan, are written only by users-service.
      allow create, update, delete: if false;

      match /paymentRequests/{requestId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Payment amounts and contract snapshots are validated transactionally
        // by payment-service; browsers must not bypass that validation.
        allow create: if false;
        allow update, delete: if false;
      }
    }
  }
}
